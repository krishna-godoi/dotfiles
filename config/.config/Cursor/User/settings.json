{
    "window.newWindowProfile": "New try",
    "workbench.settings.applyToAllProfiles": [
        "editor.fontFamily",
        "editor.fontSize"
    ],
    "workbench.colorCustomizations": {
        "editor.background": "#121214",
        "panel.background": "#121214",
        "sideBar.background": "#121214",
        "banner.background": "#121214",
        "editorGutter.background": "#121214",
        "editorIndentGuide.background1": "#222224",
        "editorIndentGuide.activeBackground1": "#424244",
        "terminal.background": "#121214",
        "terminal.ansiBrightMagenta": "#fc6a97",
        "terminal.ansiBrightGreen": "#23d18b",
        "terminal.ansiGreen": "#23d18b",
        "terminal.ansiBrightYellow": "#f5f543",
        "terminal.ansiYellow": "#e5e510",
    },
    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'monospace', monospace",
    "editor.fontSize": 16,
    "terminal.integrated.fontWeight": "600",
    "terminal.integrated.fontWeightBold": "700",
    "explorer.confirmDelete": false,
    "svelte.enable-ts-plugin": true,
    "database-client.autoSync": true,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
        "composer.json": "composer.lock",
        "psalm.xml": "psalm-baseline.xml",
        ".php-cs-fixer.php": ".php-cs-fixer.cache",
        "phpunit.xml": ".phpunit.result.cache",
        "*.php": "${basename}Test.php"
    },
    "emmet.includeLanguages": {
        "blade.php": "html",
        "twig": "html"
    },
    "files.associations": {
        "*.sqlbook": "sql",
        "*.ndjson": "jsonl",
        "*.dbclient-js": "javascript",
        ".php_cs.dist": "php",
        ".php_cs": "php",
        ".pre": "php",
        "artisan": "php"
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "_ide_helper.php": true,
        "_ide_helper_models.php": true,
        ".php_cs.cache": true,
        ".phpstorm.meta.php": true,
        ".phpunit.result.cache": true
    },
    "workbench.editor.showTabs": "single",
    "workbench.panel.showLabels": false,
    "window.dialogStyle": "custom",
    "multiCommand.commands": [
        {
            "command": "multiCommand.pageUp",
            "sequence": [
                {
                    "command": "editorScroll",
                    "args": {
                        "to": "up",
                        "by": "halfPage",
                    }
                },
                {
                    "command": "cursorMove",
                    "args": {
                        "to": "viewPortCenter"
                    }
                }
            ]
        },
        {
            "command": "multiCommand.pageDown",
            "sequence": [
                {
                    "command": "editorScroll",
                    "args": {
                        "to": "down",
                        "by": "halfPage",
                    }
                },
                {
                    "command": "cursorMove",
                    "args": {
                        "to": "viewPortCenter"
                    }
                }
            ]
        }
    ],
    "workbench.colorTheme": "onedark.nvim",
    "editor.fontLigatures": true,
    "editor.fontWeight": "400",
    "vscode-neovim.neovimInitVimPaths.linux": "~/.config/Cursor/nvim.lua",
    "editor.fontVariations": false,
    "workbench.editor.enablePreview": false,
    "window.customTitleBarVisibility": "auto",
    "diffEditor.ignoreTrimWhitespace": false,
}